{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": ".generated",
    "declaration": false,
    "sourceMap": false,
    "removeComments": false
  },
  "include": ["*.ts", "types/**/*.ts", "modules/**/*.ts"]
}
