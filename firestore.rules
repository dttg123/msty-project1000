rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/apps/{appId} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && (appId != 'dividend-os-v4'
          || resource == null
          || !('storageFormat' in resource.data)
          || resource.data.storageFormat != 'split-v1'
          || !('state' in request.resource.data));
      allow delete: if owns(uid);
      match /{document=**} {
        allow read, write: if owns(uid);
      }
    }
  }
}
